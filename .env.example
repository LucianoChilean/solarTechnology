# ==========================================================================
# SolarTechonolgy — plantilla de variables de entorno
# Copia a .env y rellena. NO subas el .env real a git.
# ==========================================================================

# --- Base de datos ---------------------------------------------------------
DB_ROOT_PASSWORD=
DB_NAME=solartech
DB_USER=st_user
DB_PASSWORD=
DB_PREFIX=stwp_

# --- Sitio -----------------------------------------------------------------
SITE_URL=http://localhost:8080
SITE_TITLE=SolarTechonolgy
# Idioma de WordPress y WooCommerce (paquete de traducción que instala setup.sh).
WP_LOCALE=es_CL

# --- Admin de WordPress ----------------------------------------------------
ADMIN_USER=st_admin
ADMIN_PASSWORD=
ADMIN_EMAIL=tu-correo@ejemplo.com

# --- Login oculto ----------------------------------------------------------
LOGIN_SLUG=acceso-solar

# --- Contacto / negocio ----------------------------------------------------
WHATSAPP_NUMBER=56974089594
CONTACT_EMAIL=tu-correo@ejemplo.com

# --- Pasarela Flow.cl ------------------------------------------------------
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_SANDBOX=yes

# --- reCAPTCHA v3 ----------------------------------------------------------
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
